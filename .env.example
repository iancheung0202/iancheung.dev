# copy to .env and fill in. the first two are required.

# random string that signs sessions
FLASK_SECRET_KEY=
# password for the story editor and the wall admin tools
PASSWORD=

# optional: "Message @iancheung.dev" box on the home card. all three or it stays hidden.
# Discord application (developer portal): OAuth2 client id and secret.
# add https://<your host>/api/message/callback under OAuth2 -> Redirects.
DISCORD_CLIENT_ID=1525674572102238248
DISCORD_CLIENT_SECRET=
# webhook of the private channel the messages should land in
MESSAGE_WEBHOOK_URL=
